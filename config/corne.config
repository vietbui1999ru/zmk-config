# Bluetooth
CONFIG_ZMK_BT_CLEAR_BONDS_ON_START=n
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Power management
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=900000

# Mouse keys (scroll layer support)
CONFIG_ZMK_MOUSE=y

# Combo timeout
CONFIG_ZMK_COMBO_TERM_MS=40

# App companion — broadcasts active layer number via BLE HID
# keyboard_layers_app_companion reads this to show layer images on screen
# NOTE: only takes effect on the central half (right by default)
CONFIG_ZMK_LAYER_STATUS_BLE_HID=y
