#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        /* ─────────────────────────────────────────────
         * Layer 0 — Colemak-DHk Angle Wide (home-row mods)
         * A=Ctrl  R=Alt  S=Shift  T=Cmd/Super
         * ───────────────────────────────────────────── */
        base {
            display-name = "COLEMAK-DHK";

            bindings = <
&kp TAB   &kp Q    &kp W    &kp F    &kp P    &kp B                    &kp J    &kp L    &kp U    &kp Y    &kp SEMI &kp BSPC
&mt LCTRL A &mt LALT R &mt LSHIFT S &mt LGUI T &kp G &kp M              &kp N    &kp E    &kp I    &kp O    &kp SQT  &kp ENTER
&kp ESC   &kp Z    &kp X    &kp C    &kp D    &kp V    &lt 2 SPACE      &kp K    &kp H    &kp COMMA &kp DOT  &kp FSLH
                        &kp LGUI &mo 3 &lt 2 SPACE          &lt 1 ENTER &mo 3 &kp RALT
            >;
        };

        /* ─────────────────────────────────────────────
         * Layer 1 — Symbols & Numbers (programming)
         * ───────────────────────────────────────────── */
        symbols {
            display-name = "SYMBOLS";

            bindings = <
&trans &kp N1 &kp N2 &kp N3 &kp N4 &kp N5              &kp LPAR &kp RPAR &kp LBKT &kp RBKT &kp LBRC &kp RBRC
&trans &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT     &kp PLUS &kp MINUS &kp EQUAL &kp ASTRK &kp FSLH &kp PIPE
&trans &kp CARET &kp AMPS &kp UNDER &kp GRAVE &kp TILDE &kp COLON &kp SEMI &kp LT &kp GT &kp BSLH
                        &trans &trans &trans           &trans &trans &trans
            >;
        };

        /* ─────────────────────────────────────────────
         * Layer 2 — Navigation / Vim / Vimium
         * H J K L = ← ↓ ↑ →
         * ───────────────────────────────────────────── */
        nav {
            display-name = "NAV";

            bindings = <
&trans &kp HOME &kp UP &kp END &kp PG_UP &trans        &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp PG_DN &trans
&trans &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans      &kp B &kp E &kp W &kp DOLLAR &kp ZERO &trans
&trans &kp ESC &kp TAB &kp ENTER &kp BSPC &trans      &trans &trans &trans &trans &trans
                        &trans &trans &trans           &trans &trans &trans
            >;
        };

        /* ─────────────────────────────────────────────
         * Layer 3 — System / Bluetooth / Media
         * ───────────────────────────────────────────── */
        system {
            display-name = "SYSTEM";

            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR_ALL   &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
&out OUT_USB &out OUT_BLE &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP     &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6
&sys_reset   &bootloader &trans       &trans       &trans          &trans &trans &trans &trans &trans
                        &trans &trans &trans        &trans &trans &trans
            >;
        };
    };
};
