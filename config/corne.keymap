#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

// Layer aliases
#define QWERTY  0
#define COLEMAK 1
#define NAV     2
#define SYM     3
#define NUM     4
#define TMUX    5
#define SCROLL  6
#define FN      7

// Homerow mod aliases (GACS order — GUI, Alt, Ctrl, Shift)
// Left hand:  A  S  D  F
// Right hand: J  K  L  ;

// Timeless HRM settings (urob-style)
&mt {
    tapping-term-ms = <200>;
    require-prior-idle-ms = <150>;
    flavor = "tap-preferred";
};

/ {
    // ─── COMBOS ──────────────────────────────────────────────
    combos {
        compatible = "zmk,combos";

        // ESC — tap J+K (right hand, easy to reach from vim)
        combo_esc {
            timeout-ms = <40>;
            key-positions = <19 20>;   // J K on QWERTY
            bindings = <&kp ESC>;
        };

        // Caps Word — both shifts (inner thumbs)
        combo_caps_word {
            timeout-ms = <40>;
            key-positions = <36 41>;   // left thumb mid + right thumb mid
            bindings = <&caps_word>;
        };

        // TMUX layer toggle — D+F (left hand middle+ring inner)
        combo_tmux {
            timeout-ms = <40>;
            key-positions = <15 16>;   // D F
            bindings = <&tog TMUX>;
        };

        // SCROLL layer toggle — M+N (right hand)
        combo_scroll {
            timeout-ms = <40>;
            key-positions = <20 21>;   // K L  (right mid row)
            bindings = <&tog SCROLL>;
        };
    };

    // ─── MACROS ──────────────────────────────────────────────
    macros {
        // Tmux prefix: sends Ctrl+B then waits for next key
        tmux_pre: tmux_prefix {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_press &kp LCTRL>
                , <&macro_tap &kp B>
                , <&macro_release &kp LCTRL>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>;
        };

        // Switch to QWERTY default layer
        to_qwerty: to_qwerty {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to QWERTY>;
        };

        // Switch to Colemak default layer
        to_colemak: to_colemak {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to COLEMAK>;
        };
    };

    // ─── BEHAVIORS ───────────────────────────────────────────
    behaviors {
        // Homerow mods — tap-preferred, timeless style
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <
                6 7 8 9 10 11        // right top row
                18 19 20 21 22 23    // right mid row
                30 31 32 33 34 35    // right bot row
                39 40 41             // right thumb
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <
                0 1 2 3 4 5          // left top row
                12 13 14 15 16 17    // left mid row
                24 25 26 27 28 29    // left bot row
                36 37 38             // left thumb
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        // Layer tap with tapping-term tuned for thumb comfort
        lt_thumb: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ══════════════════════════════════════════════════════
        // LAYER 0 — QWERTY BASE
        // Start here. Homerow mods on ASDF / JKL;
        // ══════════════════════════════════════════════════════
        qwerty_layer {
            bindings = <
// ┌──────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┐
    &kp TAB  &kp Q  &kp W  &kp E  &kp R  &kp T     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp BSPC
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &kp ESC  &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F  &kp G
             &kp H  &hmr RSHFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI  &kp SQT
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B     &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
// └──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────┘
                        &kp LALT  &lt_thumb NAV TAB  &lt_thumb SYM SPACE
                                  &lt_thumb NUM RET  &lt_thumb FN LGUI  &kp RCTRL
//                      └──────┴──────┴──────┘   └──────┴──────┴──────┘
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 1 — COLEMAK-DH BASE
        // Switch to this when ready: FN layer has the toggle
        // ══════════════════════════════════════════════════════
        colemak_layer {
            bindings = <
// ┌──────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┐
    &kp TAB  &kp Q  &kp W  &kp F  &kp P  &kp B     &kp J  &kp L  &kp U  &kp Y  &kp SEMI  &kp BSPC
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &kp ESC  &hml LGUI A  &hml LALT R  &hml LCTRL S  &hml LSHFT T  &kp G
             &kp M  &hmr RSHFT N  &hmr RCTRL E  &hmr RALT I  &hmr RGUI O  &kp SQT
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &kp LSHFT  &kp Z  &kp X  &kp C  &kp D  &kp V     &kp K  &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
// └──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────┘
                        &kp LALT  &lt_thumb NAV TAB  &lt_thumb SYM SPACE
                                  &lt_thumb NUM RET  &lt_thumb FN LGUI  &kp RCTRL
//                      └──────┴──────┴──────┘   └──────┴──────┴──────┘
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 2 — NAV
        // Vim-style navigation. HJKL on right hand.
        // Left hand: word nav, page nav, tmux split triggers
        // ══════════════════════════════════════════════════════
        nav_layer {
            bindings = <
// ┌──────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┐
    &trans  &kp PG_UP  &kp LA(LEFT)  &kp UP  &kp LA(RIGHT)  &kp HOME
            &kp HOME   &kp PG_DN     &kp PG_UP  &kp END  &trans  &kp DEL
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &kp PG_DN
            &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp END
            &trans  &kp LA(BSPC)  &trans  &trans  &trans  &trans
// └──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────┘
                        &trans  &trans  &trans     &kp TAB  &trans  &kp DEL
//                      └──────┴──────┴──────┘   └──────┴──────┴──────┘
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 3 — SYM
        // Symbols. Left = operators, Right = brackets.
        // Open brackets left hand, close right hand.
        // ══════════════════════════════════════════════════════
        sym_layer {
            bindings = <
// ┌──────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┐
    &trans  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT
            &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &kp GRAVE  &kp MINUS  &kp EQUAL  &kp LBKT  &kp LBRC
            &kp RBRC   &kp RBKT   &kp UNDER  &kp PLUS  &kp PIPE  &kp BSLH
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &kp TILDE  &kp LT  &kp GT  &kp LPAR  &kp RPAR
            &kp SEMI   &kp COLON  &kp DQT  &kp SQT  &kp QMARK  &trans
// └──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────┘
                        &trans  &trans  &trans     &trans  &trans  &trans
//                      └──────┴──────┴──────┘   └──────┴──────┴──────┘
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 4 — NUM
        // Numpad on right hand. Left hand = common ops.
        // ══════════════════════════════════════════════════════
        num_layer {
            bindings = <
// ┌──────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┐
    &trans  &trans  &trans  &trans  &trans  &trans
            &kp PLUS   &kp N7  &kp N8  &kp N9  &kp ASTRK  &trans
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans
            &kp MINUS  &kp N4  &kp N5  &kp N6  &kp FSLH   &kp DOT
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &trans  &trans  &trans  &trans  &trans
            &kp N0     &kp N1  &kp N2  &kp N3  &kp EQUAL  &trans
// └──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────┘
                        &trans  &trans  &trans     &trans  &trans  &trans
//                      └──────┴──────┴──────┘   └──────┴──────┴──────┘
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 5 — TMUX
        // Toggle with D+F combo. All bindings auto-send Ctrl+B prefix.
        // Mirrors tmux default bindings so no retraining needed.
        // ══════════════════════════════════════════════════════
        tmux_layer {
            bindings = <
// ┌──────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┐
    &tog TMUX  &tmux_pre N1  &tmux_pre N2  &tmux_pre N3  &tmux_pre N4  &tmux_pre N5
               &tmux_pre N6  &tmux_pre N7  &tmux_pre N8  &tmux_pre N9  &tmux_pre N0  &trans
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &tmux_pre A  &tmux_pre R  &tmux_pre S  &tmux_pre T  &tmux_pre G
            &tmux_pre LBKT  &tmux_pre N  &tmux_pre E  &tmux_pre I  &tmux_pre O  &trans
// (A=last-window, R=rename, S=sessions, T=clock, G=none)
// (LBKT=copy-mode, N=next-win, E=none, I=none, O=none)
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &tmux_pre Z  &tmux_pre X  &tmux_pre C  &tmux_pre D  &tmux_pre V
            &tmux_pre K  &tmux_pre H  &tmux_pre COMMA  &tmux_pre DOT  &tmux_pre FSLH  &trans
// (Z=zoom, X=kill-pane, C=new-win, D=detach, V=split-h if remapped)
// (K=none, H=none)
// └──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────┘
                        &trans  &tmux_pre MINUS  &tmux_pre BSLH
                                &tmux_pre RET    &tmux_pre SPACE  &trans
// (MINUS=split vertical, BSLH=split horizontal, RET=last-pane, SPACE=next-layout)
//                      └──────┴──────┴──────┘   └──────┴──────┴──────┘
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 6 — SCROLL
        // Toggle with K+L combo.
        // For Excalidraw / Obsidian canvas horizontal scroll.
        // Left hand = directional scroll, Right hand = fast scroll + click
        // ══════════════════════════════════════════════════════
        scroll_layer {
            bindings = <
// ┌──────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┐
    &tog SCROLL  &trans  &trans  &msc SCRL_UP    &trans          &trans
                 &trans  &trans  &mmv MOVE_UP    &trans          &trans  &trans
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans
            &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans  &trans  &trans  &trans
// └──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────┘
                        &trans  &trans  &mkp LCLK     &mkp RCLK  &mkp MCLK  &trans
//                      └──────┴──────┴──────┘   └──────┴──────┴──────┘
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 7 — FN / BT / SYSTEM
        // Function keys, Bluetooth profiles, layout switching
        // ══════════════════════════════════════════════════════
        fn_layer {
            bindings = <
// ┌──────┬──────┬──────┬──────┬──────┬──────┐   ┌──────┬──────┬──────┬──────┬──────┬──────┤
    &trans  &kp F1  &kp F2  &kp F3  &kp F4   &kp F5
            &kp F6  &kp F7  &kp F8  &kp F9   &kp F10  &trans
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &trans
            &trans        &trans        &kp F11       &kp F12      &trans  &trans
// ├──────┼──────┼──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┼──────┼──────┤
    &trans  &to_qwerty  &to_colemak  &trans  &trans  &trans
            &trans      &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &trans  &trans
// └──────┴──────┴──────┼──────┼──────┼──────┤   ├──────┼──────┼──────┼──────┴──────┴──────┘
                        &trans  &trans  &trans     &trans  &trans  &trans
//                      └──────┴──────┴──────┘   └──────┴──────┴──────┘
            >;
        };
    };
};
