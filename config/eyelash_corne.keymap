#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

#define QWERTY  0
#define COLEMAK 1
#define NUM     2
#define SYM     3
#define NAV     4
#define MEDIA   5
#define FN      6

/ {
    combos {
        compatible = "zmk,combos";

        combo_fn {
            timeout-ms = <50>;
            key-positions = <1 11>;
            bindings = <&tog FN>;
        };
        // Z key (29) + / key (40) — bottom-left and bottom-right physical keys
        combo_media {
            timeout-ms = <50>;
            key-positions = <29 40>;
            bindings = <&tog MEDIA>;
        };
        // Both middle thumbs together → NAV (positions 43 and 46)
        combo_nav {
            timeout-ms = <75>;
            key-positions = <43 46>;
            bindings = <&mo NAV>;
        };
    };

    behaviors {
        // Thumb layer tap — FIXED (removed stray &kp LGUI)
        lt_thumb: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        // Native Hyper macro — right outer thumb sends this directly
        // Karabiner kept only for scroll-wheel (Ctrl + mouse motion)
        hyper: hyper_key {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>;
        };

        aero_1: aero_1 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N1>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_2: aero_2 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N2>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_3: aero_3 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N3>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_4: aero_4 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N4>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_5: aero_5 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N5>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_6: aero_6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N6>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_7: aero_7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N7>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_8: aero_8 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N8>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_9: aero_9 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N9>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };

        scr_full: screenshot_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N3>
                      , <&macro_release &kp LGUI &kp LSHFT>;
        };
        scr_sel: screenshot_select {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N4>
                      , <&macro_release &kp LGUI &kp LSHFT>;
        };
        scr_rec: screenshot_recorder {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N5>
                      , <&macro_release &kp LGUI &kp LSHFT>;
        };

        to_qwerty:  to_qwerty  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&to QWERTY>; };
        to_colemak: to_colemak { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&to COLEMAK>; };
    };

    keymap {
        compatible = "zmk,keymap";

        // ══════════════════════════════════════════════════════
        // LAYER 0 — QWERTY
        // Left middle thumb  = &mo NUM
        // Right middle thumb = &mo SYM
        // Both middle thumbs tapped together → NAV (combo)
        // Inner thumbs = SPACE (left) / ENTER (right)
        // Right outer thumb = Hyper (native ZMK)
        // ══════════════════════════════════════════════════════
        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
// Row 0: 12 alpha + 1 encoder
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T           &trans         &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
// Row 1: 12 alpha + 3 encoder
&kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp G  &trans   &trans  &trans &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
// Row 2: 12 alpha + 2 encoder
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B  &trans          &trans  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
// Thumbs: CMD | NUM | SPC    ENT | SYM | Hyper
                   &kp LGUI  &mo NUM  &kp SPACE   &kp RET  &mo SYM  &hyper
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 1 — COLEMAK-DH
        // ══════════════════════════════════════════════════════
        colemak_layer {
            display-name = "COLEMAK";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp F  &kp P  &kp B           &trans         &kp J  &kp L  &kp U      &kp Y    &kp SEMI  &kp BSPC
&kp LSHFT  &kp A  &kp R  &kp S  &kp T  &kp G  &trans   &trans  &trans &kp M  &kp N  &kp E      &kp I    &kp O     &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C  &kp D  &kp V  &trans          &trans  &kp K  &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                    &kp LGUI  &mo NUM  &kp SPACE   &kp RET  &mo SYM  &hyper
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 2 — NUM
        // ══════════════════════════════════════════════════════
        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp N1    &kp N2   &kp N3  &kp N4  &kp N5          &trans         &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans
&trans  &aero_1   &aero_2  &aero_3 &aero_4 &aero_5 &trans  &trans  &trans &aero_6 &aero_7 &aero_8 &aero_9 &trans  &trans
&trans  &scr_full &scr_sel &scr_rec &trans  &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans  &trans
                            &trans  &trans  &trans                          &trans  &trans  &trans
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 3 — SYM
        // ══════════════════════════════════════════════════════
        sym_layer {
            display-name = "SYM";
            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT         &trans         &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR  &kp DEL
&trans  &kp GRAVE  &kp MINUS  &kp EQUAL &kp LBKT  &kp LBRC  &trans  &trans  &trans &kp RBRC  &kp RBKT  &kp UNDER &kp PLUS  &kp PIPE  &kp BSLH
&trans  &kp TILDE  &kp LT     &kp GT    &kp DQT   &kp SQT   &trans          &trans &kp COLON &kp SEMI  &kp QMARK &kp FSLH  &kp BSLH  &trans
                               &trans    &trans    &trans                            &trans    &trans    &trans
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 4 — NAV  (hold left-mid + right-mid thumb)
        //
        // AeroSpace workspace switching — mnemonic key positions:
        //   Left top:  ws:1  ws:2  ws:3  ws:R  ws:T
        //   Left home: bk-fth ws:S  ---  lyt↔  lyt|
        //   Left bot:  rsz-  rsz+  ws:C  mv-ws→mon  ws:B
        //   Right top: ws:0  HOME  UP    ws:O  ws:P  DEL
        //   Right home: PG_DN ←    ↓     →    PG_UP del-word
        //   Right bot:  ws:N  ws:M  ---   ---   ---
        //
        // Shift compounds naturally: shift + ws:X → move-node-to-workspace X
        // Ctrl compounds:            ctrl  + ←/→  → focus-monitor left/right
        // ══════════════════════════════════════════════════════
        nav_layer {
            display-name = "NAV";
            bindings = <
// Row 0
&trans  &kp LA(N1)     &kp LA(N2)     &kp LA(N3)  &kp LA(R)      &kp LA(T)        &trans         &kp LA(N0)  &kp HOME  &kp UP    &kp LA(O)  &kp LA(P)  &kp DEL
// Row 1
&trans  &kp LA(TAB)    &kp LA(S)      &trans      &kp LA(COMMA)  &kp LA(SLASH)    &trans  &trans  &trans     &kp PG_DN &kp LEFT  &kp DOWN   &kp RIGHT  &kp PG_UP  &kp LA(BSPC)
// Row 2
&trans  &kp LA(MINUS)  &kp LA(EQUAL)  &kp LA(C)   &kp LA(LS(TAB))  &kp LA(B)     &trans          &trans     &kp LA(N) &kp LA(M) &trans     &trans     &trans     &trans
// Thumbs
                        &trans  &trans  &trans                          &trans  &trans  &kp DEL
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 5 — MEDIA
        // ══════════════════════════════════════════════════════
        media_layer {
            display-name = "MEDIA";
            bindings = <
&tog MEDIA &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_EFF &trans           &trans         &trans &trans         &mmv MOVE_UP   &trans          &trans &trans
&trans     &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_SPI &trans          &trans  &trans   &trans  &trans  &trans &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &trans &trans
&trans     &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_SPD &trans          &trans  &trans           &trans  &trans &kp C_VOL_DN   &kp C_VOL_UP   &kp C_MUTE      &trans &trans
                                            &trans          &trans          &mkp LCLK                        &mkp RCLK &mkp MCLK  &trans
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 6 — FN
        // ══════════════════════════════════════════════════════
        fn_layer {
            display-name = "FN";
            bindings = <
&tog FN &kp F1       &kp F2       &kp F3       &kp F4  &kp F5          &trans         &kp F6  &kp F7       &kp F8       &kp F9      &kp F10 &trans
&trans  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans  &trans  &trans  &trans  &trans  &trans  &trans       &kp F11      &kp F12     &trans  &trans
&trans  &to_qwerty   &to_colemak  &trans       &trans  &trans  &trans          &trans  &trans  &kp C_BRI_DN &kp C_BRI_UP &bt BT_CLR  &trans  &trans
                                   &trans       &trans  &trans                          &trans  &trans       &trans
            >;
        };
    };
};
