#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>

// ─── LAYER INDICES ───────────────────────────────────────────
#define QWERTY  0
#define COLEMAK 1
#define NUM     2
#define SYM     3
#define NAV     4
#define TMUX    5
#define MEDIA   6
#define FN      7

// ─── KEY POSITIONS (48 key eyelash corne) ────────────────────
// Row 0: 12 alpha + 1 encoder top             = 13 keys
// Row 1: 12 alpha + 3 encoder (L, mid, R)     = 15 keys
// Row 2: 12 alpha + 1 rocker + 1 encoder bot  = 14 keys
// Thumbs: 6 keys
// Total: 48

/ {
    // ═══════════════════════════════════════════════════════════
    // COMBOS
    // ═══════════════════════════════════════════════════════════
    combos {
        compatible = "zmk,combos";

        // FN — Q+P (positions 1+11)
        combo_fn {
            timeout-ms = <50>;
            key-positions = <1 11>;
            bindings = <&tog FN>;
        };

        // TMUX — E+I (positions 3+9)
        combo_tmux {
            timeout-ms = <50>;
            key-positions = <3 9>;
            bindings = <&tog TMUX>;
        };

        // MEDIA — Z+/ (positions 29+40)
        combo_media {
            timeout-ms = <50>;
            key-positions = <29 40>;
            bindings = <&tog MEDIA>;
        };
    };

    // ═══════════════════════════════════════════════════════════
    // BEHAVIORS
    // ═══════════════════════════════════════════════════════════
    behaviors {

        // Left shift: tap = LSHFT, hold 800ms = CAPS
        lshft_caps: lshft_caps {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <800>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Right shift: tap = ESC
        rshft_esc: rshft_esc {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&kp RSHFT>;
        };

        // Thumb layer tap
        lt_thumb: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
    };

    // ═══════════════════════════════════════════════════════════
    // MACROS
    // ═══════════════════════════════════════════════════════════
    macros {

        // ── Hyper key (Ctrl+Alt+Cmd+Shift) ───────────────────
        hyper: hyper_key {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                , <&macro_pause_for_release>
                , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>;
        };

        // ── AeroSpace workspace macros (Hyper + 1-9) ─────────
        aero_1: aero_1 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N1>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_2: aero_2 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N2>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_3: aero_3 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N3>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_4: aero_4 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N4>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_5: aero_5 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N5>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_6: aero_6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N6>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_7: aero_7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N7>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_8: aero_8 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N8>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };
        aero_9: aero_9 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N9>
                      , <&macro_release &kp LCTRL &kp LALT &kp LGUI &kp LSHFT>; };

        // ── Screenshot macros ─────────────────────────────────
        scr_full: screenshot_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N3>
                      , <&macro_release &kp LGUI &kp LSHFT>;
        };
        scr_sel: screenshot_select {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LGUI &kp LSHFT>
                      , <&macro_tap &kp N4>
                      , <&macro_release &kp LGUI &kp LSHFT>;
        };

        // ── Tmux macros (Ctrl+S prefix) ───────────────────────
        tx_left:   tx_left   { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp H>; };
        tx_down:   tx_down   { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp J>; };
        tx_up:     tx_up     { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp K>; };
        tx_right:  tx_right  { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp L>; };
        tx_vsplit: tx_vsplit { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp MINUS>; };
        tx_hsplit: tx_hsplit { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp BSLH>; };
        tx_zoom:   tx_zoom   { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp Z>; };
        tx_kill:   tx_kill   { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp X>; };
        tx_detach: tx_detach { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp D>; };
        tx_new:    tx_new    { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp C>; };
        tx_next:   tx_next   { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp N>; };
        tx_prev:   tx_prev   { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp P>; };
        tx_last:   tx_last   { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp L>; };
        tx_sess:   tx_sess   { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp S>; };
        tx_copy:   tx_copy   { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp LBKT>; };
        tx_w1: tx_w1 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp N1>; };
        tx_w2: tx_w2 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp N2>; };
        tx_w3: tx_w3 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp N3>; };
        tx_w4: tx_w4 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp N4>; };
        tx_w5: tx_w5 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp N5>; };
        tx_w6: tx_w6 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp N6>; };
        tx_w7: tx_w7 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp N7>; };
        tx_w8: tx_w8 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp N8>; };
        tx_w9: tx_w9 { compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL>, <&macro_tap &kp S>, <&macro_release &kp LCTRL>, <&macro_tap &kp N9>; };

        // ── Layout switching ──────────────────────────────────
        to_qwerty:  to_qwerty  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&to QWERTY>; };
        to_colemak: to_colemak { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&to COLEMAK>; };
    };

    keymap {
        compatible = "zmk,keymap";

        // ══════════════════════════════════════════════════════
        // LAYER 0 — QWERTY
        // Left outer home row = LCTRL
        // Left shift: tap=LSHFT, hold 800ms=CAPS
        // Right shift: tap=ESC
        // Left outer thumb = LGUI (CMD)
        // Right outer thumb = HYPER
        // ══════════════════════════════════════════════════════
        qwerty_layer {
            display-name = "QWERTY";
            bindings = <
// Row 0: 12 alpha + 1 encoder
&kp TAB                  &kp Q  &kp W  &kp E  &kp R  &kp T              &trans              &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
// Row 1: 12 alpha + 3 encoder
&kp LCTRL                &kp A  &kp S  &kp D  &kp F  &kp G    &trans    &trans    &trans    &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
// Row 2: 12 alpha + 2 encoder/rocker
&lshft_caps CAPS LSHFT   &kp Z  &kp X  &kp C  &kp V  &kp B    &trans              &trans    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &rshft_esc
// Thumbs
                                        &kp LGUI  &lt_thumb NUM RET  &lt_thumb SYM SPACE   &lt_thumb NAV TAB  &kp RET  &hyper
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 1 — COLEMAK-DH
        // ══════════════════════════════════════════════════════
        colemak_layer {
            display-name = "COLEMAK";
            bindings = <
&kp TAB                  &kp Q  &kp W  &kp F  &kp P  &kp B              &trans              &kp J  &kp L  &kp U      &kp Y    &kp SEMI  &kp BSPC
&kp LCTRL                &kp A  &kp R  &kp S  &kp T  &kp G    &trans    &trans    &trans    &kp M  &kp N  &kp E      &kp I    &kp O     &kp SQT
&lshft_caps CAPS LSHFT   &kp Z  &kp X  &kp C  &kp D  &kp V    &trans              &trans    &kp K  &kp H  &kp COMMA  &kp DOT  &kp FSLH  &rshft_esc
                                        &kp LGUI  &lt_thumb NUM RET  &lt_thumb SYM SPACE   &lt_thumb NAV TAB  &kp RET  &hyper
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 2 — NUM
        // Top: numbers, Home: AeroSpace, Bottom: screenshots
        // ══════════════════════════════════════════════════════
        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp N1    &kp N2   &kp N3  &kp N4  &kp N5             &trans            &kp N6   &kp N7   &kp N8  &kp N9  &kp N0  &trans
&trans  &aero_1   &aero_2  &aero_3 &aero_4 &aero_5  &trans    &trans  &trans    &aero_6  &aero_7  &aero_8 &aero_9 &trans  &trans
&trans  &scr_full &scr_sel &trans  &trans  &trans   &trans              &trans   &trans   &trans   &trans  &trans  &trans  &trans
                            &trans  &trans  &trans                               &trans   &trans   &trans
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 3 — SYM
        // Home row: most used. Open left, close right.
        // ══════════════════════════════════════════════════════
        sym_layer {
            display-name = "SYM";
            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH   &kp DLLR  &kp PRCNT          &trans            &kp CARET  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
&trans  &kp GRAVE  &kp MINUS  &kp EQUAL  &kp LBKT  &kp LBRC   &trans  &trans  &trans    &kp RBRC   &kp RBKT  &kp UNDER  &kp PLUS  &kp PIPE  &kp BSLH
&trans  &kp TILDE  &kp LT     &kp GT     &kp DQT   &kp SQT    &trans          &trans    &kp COLON  &kp SEMI  &kp QMARK  &kp FSLH  &kp BSLH  &trans
                               &trans     &trans    &trans                               &trans     &trans    &trans
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 4 — NAV
        // Right: HJKL arrows. Left: word nav + mods.
        // ══════════════════════════════════════════════════════
        nav_layer {
            display-name = "NAV";
            bindings = <
&trans  &trans    &kp LA(LEFT)  &trans     &kp LA(RIGHT)  &kp HOME           &trans            &kp PG_UP  &kp HOME      &kp UP    &kp END    &trans  &kp DEL
&trans  &kp LGUI  &kp LALT      &kp LCTRL  &kp LSHFT      &kp PG_DN  &trans  &trans  &trans   &kp PG_DN  &kp LEFT      &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &kp LG(Z) &kp LG(X)    &kp LG(C)  &kp LG(V)      &kp END    &trans          &trans   &trans     &kp LA(BSPC)  &trans    &trans     &trans  &trans
                                 &trans     &trans          &trans                              &trans     &trans        &kp DEL
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 5 — TMUX (toggle E+I)
        // All bindings pre-send Ctrl+S prefix.
        // ══════════════════════════════════════════════════════
        tmux_layer {
            display-name = "TMUX";
            bindings = <
&trans  &tx_w1    &tx_w2    &tx_w3     &tx_w4     &tx_w5              &trans            &tx_w6  &tx_w7    &tx_w8     &tx_w9    &trans     &trans
&trans  &tx_sess  &tx_prev  &tx_copy   &tx_next   &trans    &trans    &trans  &trans    &trans  &tx_left  &tx_down   &tx_up    &tx_right  &trans
&trans  &tx_new   &tx_zoom  &tx_hsplit &tx_vsplit  &tx_detach &trans           &trans   &trans  &trans    &trans     &trans    &trans     &trans
                             &trans    &tx_kill    &trans                               &trans  &tx_last  &trans
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 6 — MEDIA (toggle Z+/)
        // Left: RGB. Right: volume, brightness, mouse.
        // ══════════════════════════════════════════════════════
        media_layer {
            display-name = "MEDIA";
            bindings = <
&tog MEDIA &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_EFF &trans             &trans             &trans  &trans         &mmv MOVE_UP    &trans           &trans  &trans
&trans     &rgb_ug RGB_HUI &rgb_ug RGB_SAI &rgb_ug RGB_SPI &trans          &trans   &trans    &trans  &trans     &trans  &mmv MOVE_LEFT &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &trans
&trans     &rgb_ug RGB_HUD &rgb_ug RGB_SAD &rgb_ug RGB_SPD &trans          &trans   &trans             &trans    &trans  &kp C_VOL_DN   &kp C_VOL_UP    &kp C_MUTE       &trans  &trans
                                            &trans          &trans          &mkp LCLK                             &mkp RCLK &mkp MCLK    &trans
            >;
        };

        // ══════════════════════════════════════════════════════
        // LAYER 7 — FN (toggle Q+P)
        // BT clear bottom-right, protected by requiring FN layer.
        // ══════════════════════════════════════════════════════
        fn_layer {
            display-name = "FN";
            bindings = <
&tog FN  &kp F1        &kp F2        &kp F3        &kp F4   &kp F5             &trans             &kp F6  &kp F7        &kp F8        &kp F9      &kp F10  &trans
&trans   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans   &trans   &trans    &trans  &trans     &trans  &trans        &kp F11       &kp F12     &trans   &trans
&trans   &to_qwerty    &to_colemak   &trans        &trans   &trans   &trans             &trans     &trans  &kp C_BRI_DN  &kp C_BRI_UP  &bt BT_CLR  &trans   &trans
                                      &trans        &trans   &trans                                &trans  &trans        &trans
            >;
        };
    };
};
